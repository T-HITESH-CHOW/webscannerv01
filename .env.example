# Security Review Tool v01 / CentralScan — Environment Variables
# Copy this to .env and fill in your values

# --- Scan mode ------------------------------------------------------------
# true  = simulated fixtures only (no external tools needed)
# false = built-in HTTP assessment + agentic engagement always run; external
#         engines (nuclei/nmap/nikto/semgrep/trivy/zap/strix) run when installed
SIMULATE_SCANNERS=false

# --- LLM (optional) --------------------------------------------------------
# Without a key the deterministic knowledge-base report is generated.
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-3-haiku-20240307

# --- Agentic runtime (optional: BitterSecurity/Decepticon) -------------------
# When reachable the engagement is handed to the Decepticon agent runtime;
# otherwise the native OPPLAN engine drives the engagement itself.
DECEPTICON_RUNTIME_URL=

# --- Supabase (optional, durable scan history) ------------------------------
# Create from supabase_schema.sql; use the service-role key, not the anon key.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- App ---------------------------------------------------------------------
DEBUG=true
MAX_FILE_SIZE_MB=50
# Extra CORS origins for the deployed frontend (comma separated)
CORS_EXTRA_ORIGINS=

# --- External engines ----------------------------------------------------
REDTEAM_DIR=vendor/ai-red-teaming
STRIX_CMD=strix
